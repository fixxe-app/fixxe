<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Хедер: ⚙ ↻ | статус | бейдж -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingStart="5dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_sync"
                android:contentDescription="@string/refresh"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:breakStrategy="simple"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:text="Loading…"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_count_badge"
            android:minWidth="28dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Слева FIXXE, по центру мини-лого, справа CLEAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/app_name"
            android:textColor="@color/brand_green"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_mini"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/clear"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.08"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <!-- ЭКСПЕРИМЕНТ: кнопка «спрятать клавиатуру», как на iPhone. Видна,
             только пока клавиатура открыта. Оставлять или нет — решение за
             владельцем после просмотра на эмуляторе. -->
        <ImageView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/btnClear"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard_hide"
            app:tint="@color/accent"
            android:contentDescription="@string/close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Список валют -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- Футер -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnAddCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_currency"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnSourceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mid_market"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Копирайт · атрибуция · версия — одной строкой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnAttribution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/attribution"
                android:textSize="10sp"
                android:textColor="@color/icon_muted"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/hint" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
