<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Хедер: ⚙ ↻ | статус | бейдж -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingStart="5dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/settings"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_sync"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/refresh"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </FrameLayout>

        <!-- «Рыночный курс · 13:11 · источник ⓘ». Нажатие — пояснение о курсах
             (раньше это была отдельная ссылка внизу). Счётчика валют больше нет. -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:ellipsize="end"
            android:hyphenationFrequency="none"
            android:breakStrategy="simple"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="4dp"
            android:text="Loading…"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Слева FIXXE, по центру мини-лого, справа CLEAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/app_name"
            android:textColor="@color/brand_green"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.12" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:adjustViewBounds="true"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_mini"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/clear"
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <!-- ЭКСПЕРИМЕНТ: кнопка «спрятать клавиатуру», как на iPhone. Видна,
             только пока клавиатура открыта. Оставлять или нет — решение за
             владельцем после просмотра на эмуляторе. -->
        <ImageView
            android:id="@+id/btnHideKeyboard"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/btnClear"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_keyboard_hide"
            app:tint="@color/accent"
            android:contentDescription="@string/close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Поправка к курсу включена. Полосу нельзя закрыть, пока процент не ноль:
         пересчитанный курс не должны принять за рыночный. Самого процента здесь
         нет. Нажатие открывает настройку поправки. -->
    <LinearLayout
        android:id="@+id/adjustBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@color/adjusted_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_adjust_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:text="%"
            android:textColor="@color/on_adjusted"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdjustBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:accessibilityLiveRegion="polite"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/adjusted_rates"
            android:textColor="@color/adjusted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text="›"
            android:textColor="@color/adjusted"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Поправку сбросили по сроку — об этом сообщаем, цифры молча не меняем -->
    <LinearLayout
        android:id="@+id/adjustNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="@string/adjust_reset_notice"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnAdjustUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/adjust_undo"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Список валют -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- Подвал — одна строка: «＋ Добавить валюту» и, только у ExchangeRate-API,
         их подпись со ссылкой (условие бесплатного тарифа). Номер версии — в настройках. -->
    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/btnAddCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:text="@string/add_currency"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_add"
            android:drawableTint="@color/accent"
            android:drawablePadding="4dp"
            android:paddingHorizontal="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:gravity="center_vertical|end"
            android:paddingHorizontal="4dp"
            android:text="@string/attribution"
            android:textSize="10sp"
            android:textColor="@color/icon_muted"
            android:maxLines="1"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
