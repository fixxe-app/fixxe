<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: система (или выбор пользователя в настройках) решает,
         какой набор цветов подставить — values или values-night. -->
    <style name="Theme.CurrencyConverter" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
